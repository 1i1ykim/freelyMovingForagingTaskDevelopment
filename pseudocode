# setup

def setup():
    gantry = connectZaber() # [zaber]
    for axis in ["x", "y"]: # checks whether each axis knows where it is, if not bring to known position
        if not gantry.isHome(axis):
            gantry.home(axis) 
        gantry.setLimits(axis, speed=maxSpeed, [hmm]) # controller limit: just in case
    gantry.moveto(startPosition, wait=True) # moves gantry to session start position, doesn't start until there

    camera = openCamera(cameraID, frameRate) # [bonsai] camera capture node, starts camera (hot)
    background = average(nEmptyArenaFrames) # [bonsai] background subtraction, build pic of arena by averaging n frames. anything different could be mice.
    videoFile = openVideoWriter() # [bonsai] video writer node
    logFile = openCSV() #[bonsai] csv writer node
    return gantry, camera, background, videoFile, logFile

# tracking: [bonsai] vision nodes? also DLC packages?

def findMice(frame, background):
    gray = grayscale(frame)
    diff = abs(gray - background) # subtracts empty arena from current frame. abs in case pixel is either brigher or darker than background.
    mask = morphologicalOperator(diff > threshold) # mice or not mice, then deletes noise
    maybeMice = findContours(mask) + regionAnalysis(mask) # groups touching not Background pixels

    if not maybeMice:
        return None
    mice = largest(maybeMice) # [bonsai] largest region, caveat: assumes biggest group is mice
    if not (minThreshold <= mice.area <= maxThreshold): # sanity check on size: too big (hand, shadow, etc.) can be excluded
        return None
    return mice.centroid # [bonsai] centroid property, find "center" of mice

